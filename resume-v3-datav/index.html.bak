<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YyUHua · 持续做事的记录</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=Inter:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:#121212;color:#f5f5f5;
  font-family:'Inter','PingFang SC','Microsoft YaHei',sans-serif;
  overflow-x:hidden;-webkit-font-smoothing:antialiased;
  font-weight:400;
  font-size:clamp(.85rem,1.1vw,.95rem);
  line-height:1.8;
}
::selection{background:rgba(255,77,77,.35);color:#fff}

::-webkit-scrollbar{width:2px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,77,77,.25);border-radius:4px}

/* ===== UTILITY ===== */
.r{opacity:0;transform:translateY(40px);transition:opacity .8s cubic-bezier(.23,1,.32,1),transform .8s cubic-bezier(.23,1,.32,1)}
.r.v{opacity:1;transform:translateY(0)}
.d1{transition-delay:.15s}.d2{transition-delay:.3s}.d3{transition-delay:.45s}.d4{transition-delay:.6s}

.section-label{
  font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:6px;
  color:rgba(255,77,77,.75);margin-bottom:8px;font-weight:400;
}

/* ===== NAV ===== */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;padding:20px 40px;
  display:flex;justify-content:space-between;align-items:center;
  background:linear-gradient(180deg,rgba(13,13,13,.95),transparent);
}
.nav-logo{font-size:.7rem;font-weight:500;color:#e0e0e0;letter-spacing:4px;font-family:'JetBrains Mono',monospace}
.nav-links{display:flex;gap:20px}
.nav-links a{font-size:.55rem;letter-spacing:4px;text-transform:uppercase;color:rgba(240,240,240,.7);text-decoration:none;transition:color .3s}
.nav-links a:hover{color:rgba(255,77,77,.7)}

/* ===== HERO ===== */
.hero{
  min-height:100vh;display:flex;flex-direction:column;justify-content:center;
  padding:40px 40px 40px 60px;position:relative;overflow:hidden;
}
.hero-line{position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,transparent,rgba(255,77,77,.25),transparent)}
.hero h1{
  font-family:'JetBrains Mono',monospace;
  font-size:clamp(3rem,12vw,8rem);font-weight:700;line-height:.9;
  letter-spacing:-.06em;color:#3a3a3a;margin-bottom:16px;
}
.hero h1 .hl{color:rgba(255,77,77,.75)}
.hero p{
  font-size:clamp(.85rem,1.2vw,1.05rem);color:rgba(240,240,240,.85);font-weight:400;
  max-width:500px;letter-spacing:1px;line-height:1.8;
}
.hero-metrics{
  position:absolute;right:60px;top:50%;transform:translateY(-50%);
  text-align:right;display:flex;flex-direction:column;gap:20px;
}
.hero-metric .num{font-family:'JetBrains Mono',monospace;font-size:clamp(1.2rem,2.5vw,2rem);font-weight:500;color:#f0f0f0}
.hero-metric .lbl{font-size:.5rem;letter-spacing:4px;text-transform:uppercase;color:rgba(240,240,240,.5);font-weight:400}.hero-metric .num .r_hl{color:#ff4d4d}
.hero-scroll{position:absolute;bottom:28px;left:60px;font-size:.55rem;letter-spacing:8px;color:rgba(255,77,77,.4);font-family:'JetBrains Mono',monospace}

.section{padding:140px 40px;position:relative}
.section-inner{max-width:1200px;margin:0 auto;position:relative}

/* ===== TIMELINE ===== */
.tl-wrap{position:relative;padding:20px 0}
.tl-line{position:absolute;left:24px;top:0;bottom:0;width:1px;background:rgba(255,77,77,.15)}
.tl-item{position:relative;padding:24px 0 24px 60px;border-bottom:1px solid rgba(255,255,255,.025)}
.tl-item:last-child{border-bottom:none}
.tl-dot{position:absolute;left:17px;top:28px;width:14px;height:14px;border-radius:50%;border:1px solid rgba(255,77,77,.35);background:#0d0d0d;z-index:2;transition:all .4s}
.tl-item:hover .tl-dot{background:#ff4d4d;box-shadow:0 0 20px rgba(255,77,77,.3);border-color:#ff4d4d;transform:scale(1.3)}
.tl-year{font-family:'JetBrains Mono',monospace;font-size:.5rem;color:rgba(255,77,77,.35);letter-spacing:6px;margin-bottom:2px}
.tl-title{font-size:clamp(.85rem,1.4vw,1.1rem);font-weight:500;color:#f0f0f0;margin-bottom:2px}
.tl-title .hl{color:#ff4d4d;font-weight:500}
.tl-sub{font-size:.7rem;color:rgba(240,240,240,.75);font-weight:400}
.tl-stat{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:rgba(255,77,77,.65);margin-top:4px}

/* ===== TRADING ===== */
.tr-section{background:linear-gradient(180deg,#0d0d0d,#0a0a0a 100%)}
.tr-layout{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:start}
.chart-area{position:relative}
.chart-area .tag{font-family:'JetBrains Mono',monospace;font-size:.45rem;letter-spacing:6px;color:rgba(255,77,77,.25);margin-bottom:16px}
.chart-svg{width:100%;height:auto;background:transparent}
.tr-metrics{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.02)}
.tr-metric{padding:28px 24px;text-align:center;position:relative}
.tr-metric:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.02)}
.tr-metric:nth-child(odd){border-right:1px solid rgba(255,255,255,.02)}
.tr-metric .val{font-family:'JetBrains Mono',monospace;font-size:clamp(1.4rem,3vw,2.2rem);font-weight:500;color:#f0f0f0}
.tr-metric .val.red{color:#ff4d4d}.tr-metric .val.green{color:#4ade80}
.tr-metric .lbl{font-size:.5rem;letter-spacing:4px;text-transform:uppercase;color:rgba(240,240,240,.7);margin-top:2px;font-weight:400}

.strat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:40px}
.strat-card{padding:24px;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.04);border-radius:0;transition:all .4s}
.strat-card:hover{background:rgba(255,77,77,.02);border-color:rgba(255,77,77,.08);transform:translateY(-6px)}
.strat-card .ver{font-family:'JetBrains Mono',monospace;font-size:.55rem;color:#ff4d4d;margin-bottom:4px}
.strat-card .name{font-size:.8rem;font-weight:500;color:rgba(240,240,240,.75);margin-bottom:6px}
.strat-card .desc{font-size:.68rem;color:rgba(240,240,240,.75);line-height:1.7;font-weight:400}
.strat-card .ret{font-family:'JetBrains Mono',monospace;font-size:.8rem;color:#4ade80;margin-top:8px}

/* ===== WRITING ===== */
.writing-list{display:flex;flex-direction:column;gap:2px}
.writing-item{position:relative;padding:32px 0;border-bottom:1px solid rgba(255,255,255,.025);display:grid;grid-template-columns:60px 1fr auto;gap:32px;align-items:center;transition:all .3s}
.writing-item:hover{background:rgba(255,255,255,.008)}
.writing-item .num{font-family:'Playfair Display',serif;font-size:2.5rem;font-style:italic;color:rgba(255,77,77,.06);text-align:center}
.writing-item .info .title{font-size:1rem;font-weight:500;color:rgba(240,240,240,.7);margin-bottom:4px}
.writing-item .info .desc{font-size:.7rem;color:rgba(240,240,240,.7);line-height:1.6;font-weight:400}
.writing-item .mets{display:flex;gap:20px;text-align:right}
.writing-item .mets .m{font-family:'JetBrains Mono',monospace}
.writing-item .mets .m .v{font-size:.85rem;color:rgba(240,240,240,.6);font-weight:400}
.writing-item .mets .m .l{font-size:.5rem;letter-spacing:3px;text-transform:uppercase;color:rgba(240,240,240,.25);display:block}

/* ===== HARDWARE ===== */
.hw-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:rgba(255,255,255,.02)}
.hw-item{padding:40px 32px;text-align:center;background:#0d0d0d;transition:all .4s;position:relative}
.hw-item:hover{background:rgba(255,255,255,.008)}
.hw-item .stage{font-family:'JetBrains Mono',monospace;font-size:.5rem;letter-spacing:4px;color:rgba(255,77,77,.3);margin-bottom:4px}
.hw-item .icon-box{width:100%;height:100px;display:flex;align-items:center;justify-content:center;font-size:2.8rem;margin-bottom:12px;position:relative}
.hw-item .icon-box::after{content:'';position:absolute;bottom:0;left:20%;right:20%;height:1px;background:linear-gradient(90deg,transparent,rgba(255,77,77,.08),transparent)}
.hw-item .name{font-size:.9rem;font-weight:500;color:rgba(240,240,240,.7);margin-bottom:4px}
.hw-item .desc{font-size:.68rem;color:rgba(240,240,240,.75);line-height:1.7;font-weight:400}

/* ===== DESIGN ===== */
.des-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.02)}
.des-item{padding:32px 20px;text-align:center;background:#0d0d0d;transition:all .3s}
.des-item:hover{background:rgba(255,77,77,.015)}
.des-item .ico{font-size:1.4rem;margin-bottom:6px}
.des-item .name{font-size:.75rem;color:rgba(240,240,240,.6);font-weight:400}
.des-item .yr{font-family:'JetBrains Mono',monospace;font-size:.45rem;color:rgba(255,77,77,.18);margin-top:4px}

/* ===== STATUS ===== */
.st-bar{display:flex;align-items:center;justify-content:space-between;padding:32px 40px;background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.025);flex-wrap:wrap;gap:20px}
.st-label{font-size:.45rem;letter-spacing:8px;text-transform:uppercase;color:rgba(255,77,77,.2);font-family:'JetBrains Mono',monospace}
.st-items{display:flex;gap:32px;flex-wrap:wrap}
.st-item{display:flex;align-items:center;gap:8px}
.st-dot{width:5px;height:5px;border-radius:50%;animation:dPulse 2.5s ease-in-out infinite}
.st-dot.red{background:#ff4d4d}.st-dot.green{background:#4ade80}.st-dot.gold{background:#b8952e}
@keyframes dPulse{0%,100%{opacity:.15}50%{opacity:1}}
.st-item .what{font-size:.75rem;color:rgba(240,240,240,.85);font-weight:400}
.st-item .what .hlw{color:rgba(255,77,77,.7);font-weight:500}

/* ===== FOOTER ===== */
footer{padding:40px;text-align:center}
footer p{font-family:'JetBrains Mono',monospace;font-size:.5rem;color:rgba(240,240,240,.4);letter-spacing:6px}

/* ===== SVG chart tweaks ===== */
.chart-svg line{stroke:rgba(255,255,255,.01)!important}
.chart-svg text{fill:rgba(240,240,240,.2)!important}

/* ===== RESPONSIVE ===== */
@media(max-width:900px){
  .tr-layout{grid-template-columns:1fr}
  .hero-metrics{position:static;transform:none;flex-direction:row;flex-wrap:wrap;gap:16px;margin-top:32px;text-align:left}
  .hero{padding:100px 20px 60px}
  .hw-grid{grid-template-columns:1fr}
  .des-grid{grid-template-columns:repeat(2,1fr)}
  .strat-row{grid-template-columns:1fr}
  .writing-item{grid-template-columns:1fr;gap:12px}
  .writing-item .mets{justify-content:flex-start}
}
@media(max-width:600px){
  .section{padding:80px 16px}
  .hero-metrics{flex-direction:column;gap:8px}
  .hero h1{font-size:2.5rem}
  .nav-links a:not(:first-child){display:none}
}
</style>
</head>
<body>

<nav>
  <span class="nav-logo">YyUHua</span>
  <div class="nav-links">
    <a href="#timeline">时间线</a>
    <a href="#trading">量化</a>
    <a href="#status">状态</a>
  </div>
</nav>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-line"></div>
  <h1>持续<br>做事<span class="hl">.</span></h1>
  <p>不只是作品集。是一份从2019年延伸到今天的行动记录。<br>七年，七个维度，每一个数字都是实际发生的事。</p>
  <div class="hero-metrics">
    <div class="hero-metric"><div class="num">7<span class="r_hl">年</span></div><div class="lbl">持续输出</div></div>
    <div class="hero-metric"><div class="num">100<span class="r_hl">+</span></div><div class="lbl">品牌项目</div></div>
    <div class="hero-metric"><div class="num">3</div><div class="lbl">长篇小说</div></div>
    <div class="hero-metric"><div class="num">7</div><div class="lbl">策略迭代</div></div>
  </div>
  <div class="hero-scroll">↓ 向下滚动</div>
</section>

<!-- ===== TIMELINE ===== -->
<section class="section" id="timeline">
  <div class="section-inner">
    <div class="r"><p class="section-label">/ 01</p></div>
    <div class="r d1"><p style="font-size:clamp(1.2rem,2.5vw,1.8rem);font-weight:300;color:rgba(240,240,240,.6);margin-bottom:48px;letter-spacing:-.01em">从第一个项目到今天<br><span style="color:rgba(255,77,77,.35)">七年，一个没停过的人。</span></p></div>
    <div class="tl-wrap r d2">
      <div class="tl-line"></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2019</div><div class="tl-title">成都大运会 <span class="hl">·</span> 视觉设计</div><div class="tl-sub">第一个国家级项目</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2020</div><div class="tl-title">金沙遗址博物馆 <span class="hl">·</span> 视觉设计</div><div class="tl-sub">文化遗产跨界</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2021</div><div class="tl-title">世界科幻大会 <span class="hl">·</span> 视觉设计</div><div class="tl-sub">视野拓展至未来</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2022</div><div class="tl-title">第一部长篇小说完成 <span class="hl">·</span> 35万字</div><div class="tl-sub">写作生涯开篇</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2023</div><div class="tl-title">天府机场二十大</div><div class="tl-sub">政务设计 + 38万字并行</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2024</div><div class="tl-title">V7 量化策略上线 <span class="hl">·</span> 实盘运行</div><div class="tl-sub">缠论二买二卖 + 四级结构</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2025</div><div class="tl-title">V7PRO + 第三部 + 安月总线</div><div class="tl-sub">量化迭代·写作突破百万·多Agent</div></div>
      <div class="tl-item"><div class="tl-dot"></div><div class="tl-year">2026</div><div class="tl-title">V9 · DeepThink · 三Agent生态</div><div class="tl-sub">安月架构成型，仍在迭代</div></div>
    </div>
  </div>
</section>

<!-- ===== TRADING ===== -->
<section class="section tr-section" id="trading">
  <div class="section-inner">
    <div class="r"><p class="section-label">/ 02 量化交易</p></div>
    <div class="r d1"><p style="font-size:clamp(1.2rem,2.5vw,1.8rem);font-weight:300;color:rgba(240,240,240,.6);margin-bottom:48px">模拟收益曲线 · 核心指标 · <span style="color:rgba(255,77,77,.35)">三个版本的进化</span></p></div>
    <div class="tr-layout">
      <div class="chart-area r d2">
        <div class="tag">📈 权益曲线 (V7 → V9)</div>
        <svg class="chart-svg" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid meet">
          <!-- Grid -->
          <line x1="40" y1="40" x2="580" y2="40" stroke="rgba(255,255,255,.008)" stroke-width="1"/>
          <line x1="40" y1="100" x2="580" y2="100" stroke="rgba(255,255,255,.008)" stroke-width="1"/>
          <line x1="40" y1="160" x2="580" y2="160" stroke="rgba(255,255,255,.008)" stroke-width="1"/>
          <line x1="40" y1="220" x2="580" y2="220" stroke="rgba(255,255,255,.008)" stroke-width="1"/>
          <!-- Area fill -->
          <defs>
            <linearGradient id="eqFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(255,77,77,.12)"/>
              <stop offset="100%" stop-color="rgba(255,77,77,0)"/>
            </linearGradient>
          </defs>
          <!-- Area -->
          <path d="M40,208 L52,204 L80,200 L108,194 L136,186 L164,177 L192,162 L220,148 L248,136 L276,124 L304,108 L332,88 L360,68 L388,52 L416,44 L444,36 L472,32 L500,26 L528,20 L556,14 L580,10 L580,240 L40,240 Z" fill="url(#eqFill)" opacity=".7"/>
          <!-- Line -->
          <path d="M40,208 L52,204 L80,200 L108,194 L136,186 L164,177 L192,162 L220,148 L248,136 L276,124 L304,108 L332,88 L360,68 L388,52 L416,44 L444,36 L472,32 L500,26 L528,20 L556,14 L580,10" fill="none" stroke="#ff4d4d" stroke-width="1.8" opacity=".9"/>
          <!-- Dots -->
          <circle cx="40" cy="208" r="2" fill="#ff4d4d" opacity=".5"/>
          <circle cx="580" cy="10" r="3" fill="#ff4d4d" opacity=".8"/>
          <!-- Drawdown region hint -->
          <path d="M248,136 L276,142 L304,148 L332,144" fill="none" stroke="rgba(255,77,77,.3)" stroke-width="1" stroke-dasharray="3,3"/>
          <!-- Labels -->
          <text x="40" y="234" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)">2024/01</text>
          <text x="290" y="234" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)" text-anchor="middle">2025</text>
          <text x="560" y="234" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)" text-anchor="end">2026/05</text>
          <text x="38" y="44" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)" text-anchor="end">+300%</text>
          <text x="38" y="104" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)" text-anchor="end">+100%</text>
          <text x="38" y="218" font-family="JetBrains Mono,monospace" font-size="5" fill="rgba(240,240,240,.25)" text-anchor="end">0%</text>
          <!-- Current value annotation -->
          <text x="580" y="6" font-family="JetBrains Mono,monospace" font-size="6" fill="#ff4d4d" text-anchor="end" opacity=".9">+287.3%</text>
        </svg>
      </div>
      <div class="tr-metrics r d3">
        <div class="tr-metric"><div class="val green">+187.3<small style="font-size:.35em;color:rgba(240,240,240,.3)">%</small></div><div class="lbl">累计收益率</div></div>
        <div class="tr-metric"><div class="val">72.4<small style="font-size:.35em;color:rgba(240,240,240,.3)">%</small></div><div class="lbl">胜率</div></div>
        <div class="tr-metric"><div class="val red">-8.6<small style="font-size:.35em;color:rgba(240,240,240,.3)">%</small></div><div class="lbl">最大回撤</div></div>
        <div class="tr-metric"><div class="val">1.89</div><div class="lbl">夏普比率</div></div>
        <div class="tr-metric"><div class="val">1,247</div><div class="lbl">总交易次数</div></div>
        <div class="tr-metric"><div class="val">2.4<small style="font-size:.35em;color:rgba(240,240,240,.3)">:1</small></div><div class="lbl">盈亏比</div></div>
      </div>
    </div>
    <div class="strat-row r d4">
      <div class="strat-card"><div class="ver">V7</div><div class="name">缠论二买二卖</div><div class="desc">基础结构 + 春夏秋冬四季出场</div><div class="ret">首发</div></div>
      <div class="strat-card"><div class="ver">V7PRO</div><div class="name">一类买卖点 + 双策略</div><div class="desc">缠论引擎集成，双策略并行</div><div class="ret">+42% 收益</div></div>
      <div class="strat-card"><div class="ver">V9</div><div class="name">移动止损·多级别联立</div><div class="desc">G1等比止盈 + 多周期共振过滤</div><div class="ret">-62% 回撤</div></div>
    </div>
  </div>
</section>

<!-- ===== DESIGN ===== -->
<section class="section" id="design">
  <div class="section-inner">
    <div class="r"><p class="section-label">/ 05 设计</p></div>
    <div class="r d1"><p style="font-size:clamp(1.2rem,2.5vw,1.8rem);font-weight:300;color:rgba(240,240,240,.6);margin-bottom:48px">四个世界级 IP <span style="color:rgba(255,77,77,.35)">的视觉注脚</span></p></div>
    <div class="des-grid r d2">
      <div class="des-item"><div class="ico">🏛️</div><div class="name">成都大运会</div><div class="yr">2019</div></div>
      <div class="des-item"><div class="ico">🏺</div><div class="name">金沙博物馆</div><div class="yr">2020</div></div>
      <div class="des-item"><div class="ico">🌌</div><div class="name">世界科幻大会</div><div class="yr">2021</div></div>
      <div class="des-item"><div class="ico">✈️</div><div class="name">天府机场二十大</div><div class="yr">2023</div></div>
    </div>
  </div>
</section>

<!-- ===== STATUS ===== -->
<section class="section" id="status">
  <div class="section-inner">
    <div class="r"><p class="section-label">/ 06 当前状态</p></div>
    <div class="r d1"><p style="font-size:clamp(1.2rem,2.5vw,1.8rem);font-weight:300;color:rgba(240,240,240,.6);margin-bottom:48px">此刻在做什么？<br><span style="color:rgba(255,77,77,.35)">动态更新·持续做事。</span></p></div>
    <div class="st-bar r d2">
      <div class="st-label">● 正在</div>
      <div class="st-items">
        <div class="st-item"><div class="st-dot red"></div><span class="what"><span class="hlw">开发</span> V10 策略迭代 · 自适应风控</span></div>
        <div class="st-item"><div class="st-dot green"></div><span class="what"><span class="hlw">阅读</span> 陀思妥耶夫斯基 · 卡拉马佐夫兄弟</span></div>
        <div class="st-item"><div class="st-dot gold"></div><span class="what"><span class="hlw">学习</span> Rust · 重构量化引擎核心</span></div>
      </div>
    </div>
  </div>
</section>

<footer><p>YyUHua · 我与世纪共百年 · 2026</p></footer>

<script>
// ===== REVEAL =====
document.querySelectorAll('.r').forEach(el => {
  new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('v') });
  }, { threshold: .1, rootMargin: '0px 0px -60px 0px' }).observe(el);
});

// ===== TYPEWRITER FOR HERO (subtle) =====
const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
const heroH1 = document.querySelector('.hero h1');
let scrambleInterval;

function scrambleEffect() {
  let runs = 0;
  scrambleInterval = setInterval(() => {
    const text = '持续做事.';
    let result = '';
    for (let i = 0; i < text.length; i++) {
      if (i < runs) result += text[i];
      else result += chars[Math.floor(Math.random() * chars.length)];
    }
    heroH1.innerHTML = result.replace('.', '<span class="hl">.</span>');
    if (runs >= text.length) clearInterval(scrambleInterval);
    runs++;
  }, 60);
}
setTimeout(scrambleEffect, 400);

console.log('✦ YyUHua · 数据剧场 ✦');
console.log('没有形容词，只有数字和行动。');
</script>
</body>
</html>
