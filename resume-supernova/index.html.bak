<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>YyUHua · 我与世纪共百年</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@300;400;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;font-size:16px}
body{background:#07080d;color:#c8c8d0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;overflow-x:hidden}
::selection{background:rgba(240,198,116,.25);color:#f0c674}

/* Scrollbar */
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(240,198,116,.12);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:rgba(240,198,116,.25)}

/* 3D Canvas */
#bg{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0;pointer-events:none}

/* Orb backgrounds */
.orb{position:fixed;border-radius:50%;filter:blur(120px);pointer-events:none;z-index:0;mix-blend-mode:screen;will-change:transform}
.orb-1{width:700px;height:700px;background:radial-gradient(circle,rgba(240,198,116,0.08),transparent);top:-25%;right:-15%;animation:orbFloat1 30s ease-in-out infinite}
.orb-2{width:800px;height:800px;background:radial-gradient(circle,rgba(122,93,199,0.06),transparent);bottom:-30%;left:-20%;animation:orbFloat2 35s ease-in-out infinite}
.orb-3{width:400px;height:400px;background:radial-gradient(circle,rgba(59,130,246,0.04),transparent);top:40%;left:60%;animation:orbFloat3 25s ease-in-out infinite}
.orb-4{width:300px;height:300px;background:radial-gradient(circle,rgba(240,198,116,0.04),transparent);top:70%;left:30%;animation:orbFloat1 20s ease-in-out infinite reverse}
@keyframes orbFloat1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(-100px,60px) scale(1.1)}66%{transform:translate(60px,-80px) scale(.9)}}
@keyframes orbFloat2{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(80px,-50px) scale(1.15)}66%{transform:translate(-60px,70px) scale(.85)}}
@keyframes orbFloat3{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(50px,60px) scale(1.1)}}

/* Cursor glow */
#cursorGlow{position:fixed;width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(240,198,116,0.03) 0%,transparent 60%);pointer-events:none;z-index:1;transform:translate(-50%,-50%);mix-blend-mode:screen}

/* Scroll progress */
#scrollProgress{position:fixed;right:28px;top:50%;transform:translateY(-50%);z-index:100;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:fadeIn 1s 2s forwards}
.progress-dot{width:6px;height:6px;border-radius:50%;background:rgba(240,198,116,.1);cursor:pointer;transition:all .4s cubic-bezier(.23,1,.32,1);position:relative}
.progress-dot.active{background:rgba(240,198,116,.6);box-shadow:0 0 12px rgba(240,198,116,.2);transform:scale(1.3)}
.progress-dot:hover{background:rgba(240,198,116,.4);transform:scale(1.2)}
.progress-line{position:absolute;top:0;width:1px;height:100%;background:rgba(240,198,116,.06);z-index:-1}
.progress-fill{position:absolute;top:0;width:1px;background:linear-gradient(to bottom,rgba(240,198,116,.3),rgba(122,93,199,.3));transition:height .1s linear;z-index:-1}

/* Scroll hint */
.scroll-hint{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;color:rgba(240,198,116,.1);font-size:.5rem;letter-spacing:4px;text-transform:uppercase;animation:fadeInUp 1s 2s forwards;opacity:0}
.scroll-line{width:1px;height:40px;background:linear-gradient(to bottom,rgba(240,198,116,.15),transparent);animation:scrollPulse 2.5s ease-in-out infinite}
@keyframes scrollPulse{0%,100%{opacity:.2}50%{opacity:.8}}

/* Section base */
.section{position:relative;z-index:2;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:100px 32px}
.section-inner{max-width:1080px;width:100%}

/* Section label */
.section-label{font-size:.6rem;letter-spacing:6px;text-transform:uppercase;color:rgba(240,198,116,.15);margin-bottom:6px;font-weight:400;font-family:'JetBrains Mono',monospace}
.section-title{font-size:clamp(1.8rem,4vw,3rem);font-weight:700;letter-spacing:-.02em;margin-bottom:40px;line-height:1.2;font-family:'Playfair Display',serif}
.section-title .gold{background:linear-gradient(135deg,#f0c674 0%,#d4a854 40%,#7a5dc7 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* Glass card */
.glass-card{background:rgba(255,255,255,.012);backdrop-filter:blur(32px);-webkit-backdrop-filter:blur(32px);border:1px solid rgba(240,198,116,.04);border-radius:20px;padding:40px;position:relative;overflow:hidden;transition:all .6s cubic-bezier(.23,1,.32,1)}
.glass-card::before{content:'';position:absolute;inset:0;background:radial-gradient(600px circle at var(--mx,50%) var(--my,50%),rgba(240,198,116,.04) 0%,transparent 60%);pointer-events:none;opacity:0;transition:opacity .6s}
.glass-card:hover::before{opacity:1}
.glass-card:hover{border-color:rgba(240,198,116,.08);transform:translateY(-4px);box-shadow:0 32px 80px rgba(0,0,0,.5)}
.glass-card:hover .card-glow{opacity:1}
.card-glow{position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(240,198,116,.2),transparent);opacity:0;transition:opacity .6s}

/* Reveal animations */
.reveal{opacity:0;transform:translateY(50px);transition:opacity .9s cubic-bezier(.23,1,.32,1),transform .9s cubic-bezier(.23,1,.32,1)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-60px);transition:opacity .9s cubic-bezier(.23,1,.32,1),transform .9s cubic-bezier(.23,1,.32,1)}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(60px);transition:opacity .9s cubic-bezier(.23,1,.32,1),transform .9s cubic-bezier(.23,1,.32,1)}
.reveal-right.visible{opacity:1;transform:translateX(0)}
.reveal-scale{opacity:0;transform:scale(.85);transition:opacity 1s cubic-bezier(.23,1,.32,1),transform 1s cubic-bezier(.23,1,.32,1)}
.reveal-scale.visible{opacity:1;transform:scale(1)}
.delay-1{transition-delay:.12s}
.delay-2{transition-delay:.24s}
.delay-3{transition-delay:.36s}
.delay-4{transition-delay:.48s}
.delay-5{transition-delay:.6s}

/* ---- HERO ---- */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden}
.hero-burst{position:absolute;top:50%;left:50%;width:900px;height:900px;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(240,198,116,.05) 0%,rgba(122,93,199,.02) 30%,transparent 60%);pointer-events:none;animation:burstPulse 5s ease-in-out infinite}
@keyframes burstPulse{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.5}50%{transform:translate(-50%,-50%) scale(1.2);opacity:1}}

.hero-greeting{font-size:.65rem;letter-spacing:8px;text-transform:uppercase;color:rgba(240,198,116,.1);margin-bottom:20px;font-weight:300;font-family:'JetBrains Mono',monospace;opacity:0;animation:fadeInUp 1s .3s forwards}

.hero-name-wrapper{position:relative;margin-bottom:4px}
.hero-name{font-family:'Playfair Display',serif;font-size:clamp(3.5rem,14vw,10rem);font-weight:900;letter-spacing:-.04em;line-height:1;position:relative;z-index:3;opacity:0;animation:fadeInUp 1s .5s forwards}
.hero-name .gold{background:linear-gradient(135deg,#f0c674 0%,#e2b96a 25%,#c49a4a 50%,#a07dc7 75%,#7a5dc7 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;background-size:200% 200%;animation:goldShift 6s ease-in-out infinite;filter:drop-shadow(0 0 60px rgba(240,198,116,.15))}
@keyframes goldShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.hero-subname{font-family:'Playfair Display',serif;font-size:clamp(.65rem,1.5vw,1rem);font-weight:400;font-style:italic;color:rgba(240,198,116,.12);letter-spacing:12px;margin-top:-4px;opacity:0;animation:fadeInUp 1s .7s forwards;position:relative;z-index:3}

.hero-signature{font-size:clamp(1.2rem,3.5vw,2.8rem);font-weight:200;letter-spacing:8px;margin:16px 0 8px;color:rgba(255,255,255,.06);font-family:'Playfair Display',serif;font-style:italic;opacity:0;animation:fadeInUp 1s .9s forwards;position:relative;z-index:3;min-height:1.2em}
#typewriter{display:inline-block}
#typewriter::after{content:'|';animation:cursorBlink 1s step-end infinite;color:rgba(240,198,116,.15);font-weight:100}
@keyframes cursorBlink{50%{opacity:0}}

.hero-subtitle{font-size:clamp(.6rem,1vw,.75rem);color:rgba(255,255,255,.06);font-weight:200;letter-spacing:10px;text-transform:uppercase;font-family:'JetBrains Mono',monospace;opacity:0;animation:fadeInUp 1s 1.1s forwards;position:relative;z-index:3}

.hero-divider{width:32px;height:1px;background:rgba(240,198,116,.08);margin:28px auto;opacity:0;animation:fadeInUp 1s 1.3s forwards}

.hero-buttons{display:flex;gap:10px;opacity:0;animation:fadeInUp 1s 1.5s forwards;position:relative;z-index:3;flex-wrap:wrap;justify-content:center}
.btn-glass{padding:10px 28px;border-radius:24px;background:rgba(255,255,255,.015);border:1px solid rgba(240,198,116,.06);color:rgba(240,198,116,.25);font-size:.7rem;letter-spacing:3px;cursor:pointer;transition:all .4s;text-decoration:none;font-family:'Inter',sans-serif;text-transform:uppercase}
.btn-glass:hover{background:rgba(240,198,116,.06);border-color:rgba(240,198,116,.12);color:rgba(240,198,116,.5);transform:translateY(-3px);box-shadow:0 8px 30px rgba(240,198,116,.08)}
.btn-primary{background:linear-gradient(135deg,rgba(240,198,116,.08),rgba(122,93,199,.08));border-color:rgba(240,198,116,.1);color:rgba(240,198,116,.35)}
.btn-primary:hover{background:linear-gradient(135deg,rgba(240,198,116,.15),rgba(122,93,199,.15));border-color:rgba(240,198,116,.2);color:rgba(240,198,116,.6)}

@keyframes fadeInUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* ---- About Grid ---- */
.about-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:8px}
.about-item{padding:16px 20px;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02);border-radius:12px;transition:all .4s}
.about-item:hover{background:rgba(240,198,116,.015);border-color:rgba(240,198,116,.04);transform:translateX(4px)}
.about-item .label{font-size:.55rem;letter-spacing:3px;text-transform:uppercase;color:rgba(240,198,116,.12);margin-bottom:2px;font-family:'JetBrains Mono',monospace}
.about-item .value{font-size:.85rem;color:rgba(255,255,255,.4);font-weight:300}
.about-interests{padding:14px 20px;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02);border-radius:12px}
.about-interests .label{font-size:.55rem;letter-spacing:3px;text-transform:uppercase;color:rgba(240,198,116,.12);margin-bottom:6px;font-family:'JetBrains Mono',monospace}
.tag{display:inline-block;padding:2px 12px;background:rgba(240,198,116,.04);border:1px solid rgba(240,198,116,.06);border-radius:14px;font-size:.7rem;margin:2px 3px;color:rgba(240,198,116,.3);transition:all .3s;cursor:default}
.tag:hover{background:rgba(240,198,116,.08);border-color:rgba(240,198,116,.1);color:rgba(240,198,116,.5);transform:translateY(-2px);box-shadow:0 4px 12px rgba(240,198,116,.04)}

/* ---- Stats ---- */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.stat-card{padding:24px 12px 20px;text-align:center;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02);border-radius:14px;transition:all .5s;position:relative;overflow:hidden}
.stat-card::after{content:'';position:absolute;bottom:0;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,rgba(240,198,116,.1),transparent);opacity:0;transition:opacity .5s}
.stat-card:hover::after{opacity:1}
.stat-card:hover{background:rgba(240,198,116,.01);border-color:rgba(240,198,116,.05);transform:translateY(-6px);box-shadow:0 12px 40px rgba(0,0,0,.3)}
.stat-number{font-size:1.8rem;font-weight:700;background:linear-gradient(135deg,#f0c674,#d4a854);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:4px;font-family:'JetBrains Mono',monospace}
.stat-number .plus{font-size:.5em;background:linear-gradient(135deg,#7a5dc7,#a07dc7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-label{font-size:.55rem;color:rgba(240,198,116,.1);letter-spacing:3px;text-transform:uppercase;font-family:'JetBrains Mono',monospace}

/* ---- Timeline / Experience ---- */
.exp-list{display:flex;flex-direction:column;gap:6px}
.exp-item{display:flex;align-items:center;gap:10px;padding:14px 18px;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02);border-radius:10px;transition:all .3s}
.exp-item:hover{background:rgba(240,198,116,.01);border-color:rgba(240,198,116,.04);transform:translateX(4px)}
.exp-icon{width:30px;height:30px;border-radius:6px;background:rgba(240,198,116,.04);border:1px solid rgba(240,198,116,.06);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.8rem}
.exp-text{font-size:.78rem;color:rgba(255,255,255,.35);font-weight:300;line-height:1.5}
.exp-text strong{color:rgba(255,255,255,.55);font-weight:500}
.exp-text .gold-text{color:rgba(240,198,116,.4)}

/* ---- Projects ---- */
.projects-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.project-card{padding:24px;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02);border-radius:14px;transition:all .5s;position:relative;overflow:hidden}
.project-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(240,198,116,.12),transparent);transform:scaleX(0);transition:transform .6s}
.project-card:hover::before{transform:scaleX(1)}
.project-card:hover{background:rgba(240,198,116,.012);border-color:rgba(240,198,116,.05);transform:translateY(-6px);box-shadow:0 20px 60px rgba(0,0,0,.3)}
.project-icon{font-size:1.3rem;margin-bottom:8px}
.project-name{font-size:.9rem;font-weight:500;margin-bottom:4px;color:rgba(255,255,255,.55)}
.project-desc{font-size:.7rem;color:rgba(255,255,255,.25);line-height:1.6;font-weight:300}

/* ---- Skills ---- */
.skills-group{margin-bottom:16px}
.skills-group:last-child{margin-bottom:0}
.skills-label{font-size:.6rem;letter-spacing:4px;color:rgba(240,198,116,.1);margin-bottom:8px;font-weight:400;font-family:'JetBrains Mono',monospace}
.skills-tags{display:flex;flex-wrap:wrap;gap:5px}
.skill-tag{font-size:.7rem;color:rgba(255,255,255,.25);transition:all .3s;font-weight:300;cursor:default;padding:3px 10px;border-radius:12px;background:rgba(255,255,255,.008);border:1px solid rgba(240,198,116,.02)}
.skill-tag:hover{color:rgba(240,198,116,.45);background:rgba(240,198,116,.03);border-color:rgba(240,198,116,.06);transform:translateY(-2px)}

/* ---- Footer ---- */
.footer{text-align:center;padding:60px 24px 30px;position:relative;z-index:2}
.footer-line{width:100%;height:1px;background:linear-gradient(90deg,transparent,rgba(240,198,116,.03),transparent);margin-bottom:16px}
.footer-text{font-size:.65rem;color:rgba(240,198,116,.06);font-weight:200;letter-spacing:6px;font-family:'JetBrains Mono',monospace}

/* ---- Responsive ---- */
@media(max-width:768px){
  .about-grid{grid-template-columns:1fr}
  .projects-grid{grid-template-columns:1fr}
  .stats-row{grid-template-columns:repeat(2,1fr)}
  .glass-card{padding:24px}
  .section{padding:80px 18px}
  #scrollProgress{right:14px}
  .progress-dot{width:4px;height:4px}
  .hero-name{font-size:clamp(2.5rem,18vw,4rem)}
  .hero-signature{font-size:clamp(1rem,4vw,1.8rem);letter-spacing:4px}
}
@media(max-width:480px){
  .section{padding:60px 14px}
  .hero-buttons{flex-direction:column;align-items:center}
  .btn-glass{width:100%;text-align:center}
  .stats-row{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<canvas id="bg"></canvas>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>
<div class="orb orb-4"></div>
<div id="cursorGlow"></div>

<!-- Scroll Progress -->
<div id="scrollProgress">
  <div style="position:relative;height:200px;width:1px">
    <div class="progress-line"></div>
    <div class="progress-fill" id="progressFill"></div>
  </div>
  <div class="progress-dot active" data-section="0"></div>
  <div class="progress-dot" data-section="1"></div>
  <div class="progress-dot" data-section="2"></div>
  <div class="progress-dot" data-section="3"></div>
  <div class="progress-dot" data-section="4"></div>
  <div class="progress-dot" data-section="5"></div>
  <div class="progress-dot" data-section="6"></div>
</div>

<!-- ======== HERO ======== -->
<section class="section hero" id="hero">
  <div class="hero-burst"></div>
  <p class="hero-greeting">✦ 欢迎进入我的宇宙</p>
  <div class="hero-name-wrapper">
    <h1 class="hero-name"><span class="gold">YyUHua</span></h1>
  </div>
  <p class="hero-subname">杨昀桦</p>
  <p class="hero-signature" style="display:none"></p>
  <p class="hero-signature"><span id="typewriter"></span></p>
  <p class="hero-subtitle">DESIGNER · ENGINEER · WRITER</p>
  <div class="hero-divider"></div>
  <div class="hero-buttons">
    <button class="btn-glass btn-primary" onclick="document.getElementById('about').scrollIntoView({behavior:'smooth'})">✦ 探索</button>
    <a class="btn-glass" href="mailto:18349862535@163.com">✉ 联系我</a>
  </div>
  <div class="scroll-hint"><span>SCROLL</span><div class="scroll-line"></div></div>
</section>

<!-- ======== ABOUT ======== -->
<section class="section" id="about">
  <div class="section-inner">
    <div class="reveal"><p class="section-label">/ 关于我</p><h2 class="section-title">从纸笔到代码，<br><span class="gold">在世纪的刻度上行走</span></h2></div>
    <div class="glass-card reveal delay-1" style="--mx:50%;--my:50%">
      <div class="card-glow"></div>
      <div class="about-grid">
        <div class="about-item"><div class="label">年龄</div><div class="value">25 岁</div></div>
        <div class="about-item"><div class="label">人格</div><div class="value">INFP · 双鱼座</div></div>
        <div class="about-item"><div class="label">学历</div><div class="value">四川大学 硕士（在读）</div></div>
        <div class="about-item"><div class="label">坐标</div><div class="value">四川 · 成都</div></div>
      </div>
      <div class="about-interests">
        <div class="label">兴趣</div>
        <span class="tag">☕ 咖啡</span>
        <span class="tag">✏️ 设计</span>
        <span class="tag">📖 文学创作</span>
        <span class="tag">🎵 陈奕迅</span>
        <span class="tag">📚 陀思妥耶夫斯基</span>
      </div>
    </div>
  </div>
</section>

<!-- ======== STATS ======== -->
<section class="section" id="stats">
  <div class="section-inner">
    <div class="reveal"><p class="section-label">/ 数字</p><h2 class="section-title">一些<span class="gold">冰冷的数字</span></h2></div>
    <div class="stats-row">
      <div class="stat-card reveal delay-1"><div class="stat-number"><span data-target="100">0</span><span class="plus">+</span></div><div class="stat-label">品牌营销案例</div></div>
      <div class="stat-card reveal delay-2"><div class="stat-number"><span data-target="7">0</span></div><div class="stat-label">量化策略迭代</div></div>
      <div class="stat-card reveal delay-3"><div class="stat-number"><span data-target="3">0</span></div><div class="stat-label">AI Agents</div></div>
      <div class="stat-card reveal delay-4"><div class="stat-number"><span data-target="1">0</span></div><div class="stat-label">人生·无限可能</div></div>
    </div>
  </div>
</section>

<!-- ======== EXPERIENCE ======== -->
<section class="section" id="experience">
  <div class="section-inner">
    <div class="reveal"><p class="section-label">/ 经历</p><h2 class="section-title">四场大项目 × 百场品牌案<br><span class="gold">用作品说话</span></h2></div>
    <div class="glass-card reveal delay-1" style="--mx:50%;--my:50%">
      <div class="card-glow"></div>
      <p class="skills-label">🎨 视觉设计</p>
      <div class="exp-list">
        <div class="exp-item"><div class="exp-icon">🏛️</div><div class="exp-text"><strong>成都第31届世界大学生夏季运动会</strong> — 视觉设计</div></div>
        <div class="exp-item"><div class="exp-icon">🌌</div><div class="exp-text"><strong>成都世界科幻大会</strong> — 视觉设计</div></div>
        <div class="exp-item"><div class="exp-icon">🏺</div><div class="exp-text"><strong>成都金沙遗址博物馆</strong> — 视觉设计</div></div>
        <div class="exp-item"><div class="exp-icon">✈️</div><div class="exp-text"><strong>成都天府国际机场二十大主题展</strong> — 视觉设计</div></div>
      </div>
      <p class="skills-label" style="margin-top:16px">📊 营销策划</p>
      <div class="exp-list">
        <div class="exp-item"><div class="exp-icon">📈</div><div class="exp-text">经手品牌营销案 <strong class="gold-text">超百场</strong>，覆盖文旅、文创、消费电子，全案能力</div></div>
