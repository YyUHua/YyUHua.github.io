<!-- ======== FOOTER ======== -->
<footer class="footer">
  <div class="footer-line"></div>
  <p class="footer-text">YyUHua · 我与世纪共百年 · 2026</p>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ==================== THREE.JS SCENE ====================
const canvas = document.getElementById('bg');
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.2;

// Colors
const gold = new THREE.Color('#f0c674');
const purple = new THREE.Color('#7a5dc7');
const blue = new THREE.Color('#3b82f6');

// ---- Galaxy: spiral with gold/purple gradient ----
const starCount = 12000;
const gGeo = new THREE.BufferGeometry();
const pos = new Float32Array(starCount * 3);
const colors = new Float32Array(starCount * 3);
const sizes = new Float32Array(starCount);

for (let i = 0; i < starCount; i++) {
  const radius = 2 + Math.random() * 22;
  const spiral = Math.random() * Math.PI * 8;
  const theta = spiral + radius * 0.15;
  const phi = (Math.random() - 0.5) * 0.6;

  pos[i*3] = radius * Math.cos(theta) * Math.cos(phi);
  pos[i*3+1] = radius * Math.sin(phi) * 1.5;
  pos[i*3+2] = radius * Math.sin(theta) * Math.cos(phi);

  // Color gradient: gold center → purple mid → blue outer
  const t = (radius - 2) / 22;
  let c;
  if (t < 0.4) c = gold.clone().lerp(purple, t / 0.4);
  else if (t < 0.7) c = purple.clone().lerp(blue, (t - 0.4) / 0.3);
  else c = blue.clone().lerp(new THREE.Color('#1a1a2e'), (t - 0.7) / 0.3);

  colors[i*3] = c.r;
  colors[i*3+1] = c.g;
  colors[i*3+2] = c.b;
  sizes[i] = 0.03 + Math.random() * 0.08;
}

gGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
gGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
gGeo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

const gMat = new THREE.PointsMaterial({
  size: 0.06,
  vertexColors: true,
  transparent: true,
  opacity: 0.8,
  blending: THREE.AdditiveBlending,
  sizeAttenuation: true
});
const galaxy = new THREE.Points(gGeo, gMat);
scene.add(galaxy);

// ---- Background stars ----
const bGeo = new THREE.BufferGeometry();
const bPos = new Float32Array(4000 * 3);
for (let i = 0; i < 4000 * 3; i++) bPos[i] = (Math.random() - 0.5) * 120;
bGeo.setAttribute('position', new THREE.BufferAttribute(bPos, 3));
const bMat = new THREE.PointsMaterial({ size: 0.012, color: 0xffffff, transparent: true, opacity: 0.1, blending: THREE.AdditiveBlending, sizeAttenuation: true });
const stars = new THREE.Points(bGeo, bMat);
scene.add(stars);

// ---- Central: Golden Torus Knot (double) ----
const tkGeo = new THREE.TorusKnotGeometry(1.8, 0.4, 180, 24);
const tkMat = new THREE.MeshBasicMaterial({
  color: 0xf0c674,
  wireframe: true,
  transparent: true,
  opacity: 0.06
});
const torusKnot = new THREE.Mesh(tkGeo, tkMat);
torusKnot.position.set(0, 0, -2);
scene.add(torusKnot);

// Inner ring
const tkGeo2 = new THREE.TorusKnotGeometry(1.2, 0.2, 120, 16);
const tkMat2 = new THREE.MeshBasicMaterial({
  color: 0x7a5dc7,
  wireframe: true,
  transparent: true,
  opacity: 0.04
});
const torusKnot2 = new THREE.Mesh(tkGeo2, tkMat2);
torusKnot2.position.set(0, 0, -1);
scene.add(torusKnot2);

// Golden ring
const rGeo = new THREE.TorusGeometry(2.4, 0.02, 64, 100);
const rMat = new THREE.MeshBasicMaterial({
  color: 0xf0c674,
  transparent: true,
  opacity: 0.03
});
const ring = new THREE.Mesh(rGeo, rMat);
ring.position.set(0, 0, -3);
ring.rotation.x = Math.PI / 2.5;
scene.add(ring);

// Second ring (purple)
const rGeo2 = new THREE.TorusGeometry(2.8, 0.015, 64, 100);
const rMat2 = new THREE.MeshBasicMaterial({
  color: 0x7a5dc7,
  transparent: true,
  opacity: 0.02
});
const ring2 = new THREE.Mesh(rGeo2, rMat2);
ring2.position.set(0, 0, -3);
ring2.rotation.y = Math.PI / 3;
ring2.rotation.x = Math.PI / 4;
scene.add(ring2);

// Small floating particles around center
const fCount = 300;
const fGeo = new THREE.BufferGeometry();
const fPos = new Float32Array(fCount * 3);
for (let i = 0; i < fCount; i++) {
  const r = 2.8 + Math.random() * 1.5;
  const theta = Math.random() * Math.PI * 2;
  const phi = Math.random() * Math.PI * 2;
  fPos[i*3] = r * Math.sin(theta) * Math.cos(phi);
  fPos[i*3+1] = r * Math.sin(theta) * Math.sin(phi);
  fPos[i*3+2] = r * Math.cos(theta);
}
fGeo.setAttribute('position', new THREE.BufferAttribute(fPos, 3));
const fMat = new THREE.PointsMaterial({ size: 0.015, color: 0xf0c674, transparent: true, opacity: 0.04, blending: THREE.AdditiveBlending, sizeAttenuation: true });
const floaters = new THREE.Points(fGeo, fMat);
scene.add(floaters);

camera.position.z = 10;

// Mouse tracking
let mouseX = 0, mouseY = 0;
let targetRotX = 0, targetRotY = 0;
let scrollY = 0;

document.addEventListener('mousemove', e => {
  mouseX = (e.clientX / window.innerWidth - 0.5) * 0.6;
  mouseY = (e.clientY / window.innerHeight - 0.5) * 0.6;
});

window.addEventListener('scroll', () => {
  const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
  scrollY = window.scrollY / maxScroll;
  updateProgress(scrollY);
}, { passive: true });

// Progress bar
function updateProgress(p) {
  const fill = document.getElementById('progressFill');
  fill.style.height = (p * 100) + '%';
  const dots = document.querySelectorAll('.progress-dot');
  const activeIdx = Math.min(Math.floor(p * dots.length), dots.length - 1);
  dots.forEach((d, i) => {
    d.classList.toggle('active', i <= activeIdx);
  });
}

// Progress dots click
document.querySelectorAll('.progress-dot').forEach(dot => {
  dot.addEventListener('click', () => {
    const idx = parseInt(dot.dataset.section);
    const sections = ['hero', 'about', 'stats', 'experience', 'engineering', 'skills', 'skills'];
    if (sections[idx]) {
      document.getElementById(sections[idx]).scrollIntoView({ behavior: 'smooth' });
    }
  });
});

// ---- TorusKnot data points (for the "quant" section) ----
const dotCount = 150;
const dGeo = new THREE.BufferGeometry();
const dPos = new Float32Array(dotCount * 3);
const dCol = new Float32Array(dotCount * 3);
for (let i = 0; i < dotCount; i++) {
  const t = (i / dotCount) * Math.PI * 6;
  const r = 2.5 + Math.sin(t * 3) * 0.3;
  dPos[i*3] = r * Math.cos(t);
  dPos[i*3+1] = r * Math.sin(t * 0.7) * 0.5;
  dPos[i*3+2] = r * Math.sin(t);
  const c = gold.clone().lerp(purple, Math.sin(t) * 0.5 + 0.5);
  dCol[i*3] = c.r;
  dCol[i*3+1] = c.g;
  dCol[i*3+2] = c.b;
}
dGeo.setAttribute('position', new THREE.BufferAttribute(dPos, 3));
dGeo.setAttribute('color', new THREE.BufferAttribute(dCol, 3));
const dMat = new THREE.PointsMaterial({
  size: 0.025,
  vertexColors: true,
  transparent: true,
  opacity: 0.15,
  blending: THREE.AdditiveBlending,
  sizeAttenuation: true
});
const dataPoints = new THREE.Points(dGeo, dMat);
dataPoints.position.set(0, 0, 1);
scene.add(dataPoints);

// ---- Animation loop ----
function animate() {
  requestAnimationFrame(animate);

  // Smooth mouse follow
  targetRotX += (mouseY * 0.3 - targetRotX) * 0.02;
  targetRotY += (mouseX * 0.3 - targetRotY) * 0.02;

  // Scroll affects rotation speed
  const scrollSpeed = 1 + scrollY * 2;

  galaxy.rotation.y += 0.0004 * scrollSpeed;
  galaxy.rotation.x += 0.00015 * scrollSpeed;
  galaxy.rotation.x += targetRotX * 0.0003;
  galaxy.rotation.y += targetRotY * 0.0003;

  stars.rotation.y += 0.0001 * scrollSpeed;
  stars.rotation.x += targetRotX * 0.0002;
  stars.rotation.y += targetRotY * 0.0002;

  torusKnot.rotation.x += 0.0015 * scrollSpeed + targetRotX * 0.002;
  torusKnot.rotation.y += 0.0025 * scrollSpeed + targetRotY * 0.002;

  torusKnot2.rotation.x += 0.002 * scrollSpeed + targetRotX * 0.0015;
  torusKnot2.rotation.y -= 0.003 * scrollSpeed + targetRotY * 0.0015;

  ring.rotation.z += 0.0005 * scrollSpeed;
  ring.rotation.x += targetRotX * 0.0005;

  ring2.rotation.y += 0.0008 * scrollSpeed;
  ring2.rotation.x += targetRotY * 0.0005;

  // Floaters orbit
  floaters.rotation.y += 0.002 * scrollSpeed;
  floaters.rotation.x += targetRotX * 0.001;

  // Data points rotation
  dataPoints.rotation.y += 0.001 * scrollSpeed;
  dataPoints.rotation.x += targetRotY * 0.001;

  // Camera subtle movement based on scroll
  camera.position.z = 10 - scrollY * 2;
  camera.position.x = targetRotY * 2;
  camera.position.y = -targetRotX * 1.5 + scrollY * 0.5;
  camera.lookAt(0, 0, 0);

  renderer.render(scene, camera);
}
animate();

// Resize
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// ---- Glass card parallax ----
document.querySelectorAll('.glass-card').forEach(card => {
  card.addEventListener('mousemove', e => {
    const rect = card.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width * 100);
    const y = ((e.clientY - rect.top) / rect.height * 100);
    card.style.setProperty('--mx', x + '%');
    card.style.setProperty('--my', y + '%');
  });
});

// ---- Typewriter ----
const text = '我 与 世 纪 共 百 年';
const el = document.getElementById('typewriter');
let idx = 0;
function typeNext() {
  if (idx < text.length) {
    el.textContent += text[idx];
    idx++;
    setTimeout(typeNext, 60 + Math.random() * 40);
  }
}
setTimeout(typeNext, 1800);

// ---- Scroll Reveal ----
const revealObserver = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
  revealObserver.observe(el);
});

// ---- Counters ----
const counterObserver = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting || entry.target.classList.contains('counted')) return;
    entry.target.classList.add('counted');
    const target = parseInt(entry.target.dataset.target);
    if (isNaN(target)) return;
    const duration = 2000;
    const start = performance.now();
    function tick(now) {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      entry.target.textContent = Math.floor(eased * target);
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  });
}, { threshold: 0.5 });

document.querySelectorAll('[data-target]').forEach(el => counterObserver.observe(el));

// ---- Cursor glow follow ----
document.addEventListener('mousemove', e => {
  const glow = document.getElementById('cursorGlow');
  glow.style.left = e.clientX + 'px';
  glow.style.top = e.clientY + 'px';
});

console.log('✦ YyUHua · 我与世纪共百年 ✦');
console.log('Built by 夏嫣 · surpassed 疏月 😏');
</script>
</body>
</html>
