      </div>
      <div class="skills-group">
        <p class="skills-label">💻 开发</p>
        <div class="skills-tags">
          <span class="skill-tag">Python</span><span class="skill-tag">API 集成</span><span class="skill-tag">Linux 部署</span>
          <span class="skill-tag">Claude Code</span><span class="skill-tag">Docker</span><span class="skill-tag">Git</span><span class="skill-tag">CI/CD</span>
        </div>
      </div>
      <div class="skills-group">
        <p class="skills-label">🎯 综合能力</p>
        <div class="skills-tags">
          <span class="skill-tag">品牌视觉设计</span><span class="skill-tag">营销全案策划</span><span class="skill-tag">量化交易</span>
          <span class="skill-tag">AI 工程</span><span class="skill-tag">多智能体系统</span><span class="skill-tag">文学创作</span>
