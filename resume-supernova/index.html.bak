<section class="section" id="skills">
  <div class="section-inner">
    <div class="reveal"><p class="section-label">/ 工具</p><h2 class="section-title">技术是<span class="gold">思想的延伸</span></h2></div>
    <div class="glass-card reveal delay-1" style="--mx:50%;--my:50%">
      <div class="card-glow"></div>
      <div class="skills-group">
        <p class="skills-label">🤖 AI 模型</p>
        <div class="skills-tags">
          <span class="skill-tag">Claude</span><span class="skill-tag">DeepSeek</span><span class="skill-tag">GPT-5.5</span>
          <span class="skill-tag">火山引擎</span><span class="skill-tag">硅基流动</span><span class="skill-tag">Qwen</span>
